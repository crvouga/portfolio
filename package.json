{
  "type": "module",
  "scripts": {
    "start": "bun --watch ./src/main.ts & bunx serve dist",
    "dev": "bun run start",
    "local": "bun run start",
    "build": "bun run ./src/main.ts",
    "test": "bun test",
    "typecheck": "tsc",
    "tc": "bun run typecheck",
    "gh": "open https://github.com/crvouga/chrisvouga.dev",
    "optimize-images": "bun run ./src/optimize-images.ts",
    "screenshot-work": "bun run ./src/screenshot-work-websites.ts",
    "screenshot-projects": "bun run ./src/screenshot-project-websites.ts",
    "screenshot-main": "bun run ./src/screenshot-main-site.ts",
    "generate-all": "bun run screenshot-work && bun run screenshot-projects && bun run optimize-images && bun run generate-resume && bun run screenshot-main",
    "generate-resume": "bun run ./src/generate-resume.ts",
    "preview": "docker build -t portfolio-app . && docker run -p 80:80 portfolio-app",
    "clone-projects": "bun run scripts/clone-projects.ts",
    "health-check-urls": "bun run scripts/health-check-urls.ts",
    "generate-deploy-matrix": "bun run scripts/generate-deploy-matrix.ts",
    "fly:bootstrap": "bun run scripts/fly/bootstrap-apps.ts",
    "fly:sync-secrets": "bun run scripts/fly/sync-secrets.ts",
    "fly:deploy": "bun run scripts/fly/deploy-app.ts",
    "fly:teardown": "bun run scripts/fly/teardown-apps.ts",
    "cf:setup-zone": "bun run scripts/cloudflare/setup-zone.ts",
    "cf:sync-dns": "bun run scripts/cloudflare/sync-dns.ts",
    "decommission-cloudflare-workers": "bun run scripts/decommission-cloudflare-workers.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.48.0",
    "typescript": "^5.9.3"
  }
}